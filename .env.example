# Copy to .env for local dev, or set the same names in Vercel > Settings > Environment Variables.
# Never commit real values.

# --- Browser (public, inlined at build time) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server (never exposed to the browser) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional integrations ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
THEODDSAPI_KEY=

# --- Scan endpoint hardening ---
# When set, POST/GET /api/public/poll requires: Authorization: Bearer <POLL_SECRET>
POLL_SECRET=
# Delay between scan cycles inside one poll invocation (ms)
POLL_INTERVAL_MS=2000
